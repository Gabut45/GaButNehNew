<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:layout_width="match_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_height="80dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:id="@+id/task_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_task_hr"
        android:paddingHorizontal="@dimen/_10sdp">

        <com.makeramen.roundedimageview.RoundedImageView
            android:id="@+id/task_icon"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:layout_centerVertical="true"
            android:src="@drawable/user"
            app:riv_corner_radius="10dp" />

        <TextView
            android:id="@+id/task_time"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:text="5m"
            android:textSize="8sp"
            android:layout_marginTop="@dimen/_10sdp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/bg_btn_secondary"
            android:gravity="center"/>

        <LinearLayout
            android:id="@+id/lay"
            android:layout_width="210dp"
            android:layout_height="match_parent"
            android:layout_toEndOf="@+id/task_icon"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingLeft="15dp">

            <TextView
                android:id="@+id/task_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Santa Reward"
                android:textColor="@color/white"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/task_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Register and Deposit 50 Rs to get 99 coins"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/desc_color"
                android:textSize="11sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:layout_alignParentEnd="true"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_icon_squre">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/coin" />

            <TextView
                android:id="@+id/task_coin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:text="99"
                android:textColor="@color/white"
                android:textSize="14sp" />

        </LinearLayout>

    </RelativeLayout>

    <include
        android:id="@+id/shimmer_layout"
        layout="@layout/layout_shimmer"/>

</RelativeLayout>