<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:layout_width="match_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_height="80dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:id="@+id/leaderboardLyt"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@drawable/bg_task_hr"
        android:paddingHorizontal="@dimen/_10sdp">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/userImg"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:layout_centerVertical="true"
            android:src="@drawable/user"
            app:civ_border_color="#ffff33"
            app:civ_border_width="2dp"/>

        <LinearLayout
            android:id="@+id/lay"
            android:layout_width="210dp"
            android:layout_height="match_parent"
            android:layout_toEndOf="@+id/userImg"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingLeft="15dp">

            <TextView
                android:id="@+id/userName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Mainuddin Sk"
                android:textColor="#ffff33"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_btn_header">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/coin"
                    android:adjustViewBounds="true"/>

                <TextView
                    android:id="@+id/userCoins"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="999"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:layout_marginStart="2dp"
                    android:textStyle="bold"/>

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:layout_alignParentEnd="true"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_icon_squre">

            <TextView
                android:id="@+id/userPos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#1"
                android:textColor="#ffff33"
                android:textSize="20sp"
                android:textStyle="bold"/>

        </LinearLayout>



    </RelativeLayout>

<include
    android:id="@+id/shimmer_layout"
    layout="@layout/layout_shimmer"/>

</RelativeLayout>