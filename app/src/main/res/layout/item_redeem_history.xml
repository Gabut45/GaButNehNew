<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_height="80dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:id="@+id/redeemHistoryLyt"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@drawable/bg_task_hr"
        android:paddingHorizontal="@dimen/_10sdp">

        <LinearLayout
            android:id="@+id/ll"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_icon_squre">

            <TextView
                android:id="@+id/methodName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PayTm"
                android:paddingHorizontal="5dp"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:maxLines="1"
                android:textStyle="bold"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/lay"
            android:layout_width="210dp"
            android:layout_height="match_parent"
            android:layout_toEndOf="@+id/ll"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingLeft="15dp">

            <TextView
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="2023-04-05"
                android:textColor="@color/white"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_btn_header">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/coin"
                    android:adjustViewBounds="true"/>

                <TextView
                    android:id="@+id/coins"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="999"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:layout_marginStart="2dp"
                    android:textStyle="bold"/>

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/status"
            android:layout_width="@dimen/_55sdp"
            android:layout_height="wrap_content"
            android:text="success"
            android:background="@drawable/bg_success"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:paddingVertical="@dimen/_5sdp"
            android:paddingHorizontal="@dimen/_10sdp"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:maxLines="1"
            android:textStyle="bold"
            android:textAlignment="center"
            tools:ignore="SmallSp" />

    </RelativeLayout>

    <include
        android:id="@+id/shimmer_layout"
        layout="@layout/layout_shimmer_redeem_history"/>

</RelativeLayout>