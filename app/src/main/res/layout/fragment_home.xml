<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg"
    tools:context=".fragments.HomeFragment">

    <include
        android:id="@+id/layoutProfile"
        layout="@layout/layout_profile"
        />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager2"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_150sdp"
        android:paddingStart="@dimen/_30sdp"
        android:paddingEnd="@dimen/_30sdp"
        android:layout_marginTop="@dimen/_10sdp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginHorizontal="@dimen/_10sdp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/checkInBtn"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="4"
                android:background="@drawable/bg_task"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:gravity="center"
                    android:text="Check in"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textAllCaps="true"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="11sp" />


                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/ic_checkIn"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true"
                    app:lottie_fileName="checkin.json"
                    android:transitionName="spinTransition"/>



            </LinearLayout>

            <LinearLayout
                android:id="@+id/spinBtn"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="4"
                android:background="@drawable/bg_task"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:gravity="center"
                    android:text="@string/text_spin"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textAllCaps="true"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="11sp" />


                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/ic_spin"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true"
                    app:lottie_fileName="spin_wheel.json"
                    android:transitionName="spinTransition"/>



            </LinearLayout>

            <LinearLayout
                android:id="@+id/gameBtn"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="4"
                android:background="@drawable/bg_task"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:gravity="center"
                    android:text="@string/text_games"
                    android:textAllCaps="true"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="11sp" />

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/ic_game"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true"
                    app:lottie_fileName="game.json"/>


            </LinearLayout>

            <LinearLayout
                android:id="@+id/taskBtn"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="4"
                android:background="@drawable/bg_task"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:gravity="center"
                    android:text="@string/text_task"
                    android:textAllCaps="true"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="11sp" />

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/ic_task"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true"
                    app:lottie_fileName="task.json"
                    android:transitionName="dialogTransition"/>


            </LinearLayout>


        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginHorizontal="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_10sdp">

        <ImageView
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/ic_game"
            android:layout_marginEnd="5dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/text_games"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:layout_gravity="center_vertical"/>

        <TextView
            android:id="@+id/viewAllBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/text_view_all"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:layout_gravity="center_vertical"
            android:gravity="end"
            android:paddingRight="5dp"/>

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/_10sdp"
        android:paddingHorizontal="@dimen/_10sdp"/>

</LinearLayout>