<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:LuckyWheel="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg"
    tools:context=".activities.SpinActivity">

    <include
        android:id="@+id/layoutProfile"
        layout="@layout/layout_profile"/>

    <RelativeLayout
        android:id="@+id/spinLyt"
        android:layout_width="@dimen/_250sdp"
        android:layout_height="@dimen/_250sdp"
        android:layout_centerHorizontal="true"
        android:layout_below="@+id/layoutProfile"
        android:layout_marginTop="@dimen/_5sdp">

        <santacoder.luckywheel.LuckyWheelView
            android:id="@+id/spin_wheel"
            android:layout_width="@dimen/_230sdp"
            android:layout_height="@dimen/_230sdp"
            android:layout_centerInParent="true"
            app:lkwBackgroundColor="@android:color/transparent"
            app:lkwTopTextColor="@color/white" />

        <ImageView
            android:id="@+id/spinnerRing"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            android:src="@drawable/spin_round"
            android:transitionName="spinTransition" />

        <ImageView
            android:id="@+id/spin_icon"
            android:layout_width="@dimen/_65sdp"
            android:layout_height="@dimen/_65sdp"
            android:layout_centerInParent="true"
            android:adjustViewBounds="true"
            android:src="@drawable/spin_mid" />


    </RelativeLayout>

    <TextView
        android:id="@+id/cooldownTimerText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:visibility="gone"
        android:layout_centerHorizontal="true"
        android:layout_below="@+id/spinLyt"
        android:layout_marginTop="12dp"
        android:text="Cooldown timer here" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/playBtn"
        android:layout_width="300dp"
        android:layout_height="60dp"
        android:background="@drawable/btnmenuhijau"
        android:layout_below="@+id/cooldownTimerText"
        android:layout_centerHorizontal="true"
        android:text="PUTAR RODA"
        android:textAllCaps="true"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="24sp"
        android:layout_marginTop="@dimen/_10sdp"/>

    <TextView
        android:id="@+id/availableSpins"
        android:layout_below="@+id/playBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="15 Spins Available"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="15sp"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_centerHorizontal="true"/>

    <include
        android:id="@+id/bannerLayout"
        layout="@layout/layout_banner_ads"/>

</RelativeLayout>