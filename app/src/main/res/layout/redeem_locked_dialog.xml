<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_bg_redeem"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_rate"
            android:tint="@color/custom_red"
            android:layout_gravity="center"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fitur Tukar Berlian\nMasih Terkunci"
            android:gravity="center"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="10dp"
            android:textColor="@color/black"/>

        <TextView
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:text="Fitur Tukar Berlian akan terbuka setelah kamu memiliki minimal 10000 Berlian.\nYuk tingkatkan terus jumlah berlianmu!"
            android:textAlignment="center"
            android:layout_marginTop="10dp"
            android:textColor="@color/black"/>

        <!-- Disclaimer -->
        <TextView
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:text="DISCLAIMER:\nBerlian adalah mata uang virtual yang tidak memiliki nilai moneter riil di luar aplikasi dan tidak dapat ditukar dengan uang tunai (fiat currency), mata uang kripto atau ditransfer ke rekening bank.\n\nBerlian tidak dapat dipindahtangankan ke user lain.\n\nKami berhak untuk menolak atau membatalkan penukaran berlian jika terdeteksi adanya indikasi kecurangan, penggunaan bot, manipulasi skor, atau pelanggaran lainnya terhadap ketentuan kami."
            android:textSize="12sp"
            android:layout_marginTop="15dp"
            android:textAlignment="center"
            android:textColor="@color/black"/>

        <Button
            android:id="@+id/btnOk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mengerti"
            android:layout_marginTop="15dp"/>
    </LinearLayout>
</ScrollView>
