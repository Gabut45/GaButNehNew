<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/gameLayout"
    android:layout_width="match_parent"
    android:layout_height="80dp">

    <RelativeLayout
        android:id="@+id/gameLyt"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_task_hr"
        android:paddingHorizontal="@dimen/_10sdp">

        <com.makeramen.roundedimageview.RoundedImageView
            android:id="@+id/game_logo"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:layout_centerVertical="true"
            android:src="@drawable/user"
            app:riv_corner_radius="10dp"/>

        <LinearLayout
            android:id="@+id/lay"
            android:layout_width="210dp"
            android:layout_height="match_parent"
            android:layout_toEndOf="@+id/game_logo"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingLeft="15dp">

            <TextView
                android:id="@+id/game_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Mainuddin Sk"
                android:textColor="@color/white"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="@dimen/_150sdp"
                android:layout_height="22dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_btn_header">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/coin"
                    android:adjustViewBounds="true"/>

                <TextView
                    android:id="@+id/game_coin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="100"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:layout_marginStart="2dp"
                    android:textStyle="bold"/>

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:layout_alignParentEnd="true"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_icon_squre">

            <ImageView
                android:id="@+id/ic_clock"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/ic_clock"
                android:adjustViewBounds="true"/>

            <TextView
                android:id="@+id/game_play_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5 Min"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"/>

        </LinearLayout>

    </RelativeLayout>

    <include
        android:id="@+id/shimmer_layout"
        layout="@layout/layout_shimmer"/>

</RelativeLayout>
