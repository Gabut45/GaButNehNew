<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg"
    tools:context=".fragments.ReferFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <RelativeLayout
                android:id="@+id/topLyt"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_330sdp"
                android:layout_marginTop="?android:attr/actionBarSize">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:src="@drawable/bg_whole_round"
                    android:adjustViewBounds="true"
                    android:scaleType="centerCrop"
                    android:layout_centerInParent="true"/>

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:adjustViewBounds="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/social" />

                <de.hdodenhof.circleimageview.CircleImageView
                    android:layout_width="130dp"
                    android:layout_height="130dp"
                    android:layout_centerInParent="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/logo" />


            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/referCodeLyt"
                android:layout_below="@+id/topLyt"
                android:layout_width="300dp"
                android:layout_height="60dp"
                android:background="@drawable/btnmenubiru"
                android:layout_centerHorizontal="true"
                android:paddingHorizontal="@dimen/_10sdp">

                <TextView
                    android:id="@+id/referCodeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SANTA786"
                    android:textColor="@color/white"
                    android:layout_centerInParent="true"
                    android:textSize="25sp"
                    android:textAllCaps="true"
                    android:textStyle="bold"/>

                <ImageView
                    android:visibility="gone"
                    android:id="@+id/copyBtn"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_copy"
                    android:layout_gravity="center_vertical"
                    app:tint="@color/white"/>

            </RelativeLayout>

            <TextView
                android:id="@+id/referDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="dec"
                android:textColor="@color/white"
                android:layout_below="@+id/referCodeLyt"
                android:layout_marginTop="@dimen/_10sdp"
                android:textAlignment="center"
                android:layout_marginHorizontal="@dimen/_10sdp"
                android:textSize="14sp"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/inviteBtn"
                android:layout_width="300dp"
                android:layout_height="55dp"
                android:background="@drawable/btnmenuhijau"
                android:layout_below="@+id/referDesc"
                android:layout_centerHorizontal="true"
                android:text="Undang Sekarang"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:layout_marginTop="@dimen/_10sdp"/>

        </RelativeLayout>

    </ScrollView>

</RelativeLayout>