<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Warna background putih -->
    <solid android:color="@android:color/white" />

    <!-- Sudut melengkung 16dp -->
    <corners android:radius="16dp" />

    <!-- Padding dalam drawable (optional, biasanya diatur di layout) -->
    <padding
        android:left="16dp"
        android:top="16dp"
        android:right="16dp"
        android:bottom="16dp" />

    <!-- Minimal lebar dialog (optional) -->
    <size android:minWidth="280dp" />

    <!-- Shadow bisa dibuat dengan elevation di dialog,
         biasanya tidak pakai di drawable ini langsung -->

</shape>
